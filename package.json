{
  "name": "fastweb",
  "version": "0.10.0",
  "description": "Search accelerator — official alternates, bookmarks & prefetch right on SERP",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "dev:opera": "wxt -b opera",
    "build:opera": "wxt build -b opera",
    "zip:opera": "wxt zip -b opera",
    "zip:all": "wxt zip && wxt zip -b firefox && wxt zip -b edge && wxt zip -b opera",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "check": "tsc --noEmit && eslint src/"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^9.39.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.0",
    "wxt": "^0.19.0"
  }
}
